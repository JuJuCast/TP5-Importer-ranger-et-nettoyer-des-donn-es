# 2. Importation de auto2004_original_ligne3.txt
# On regarde d'abord les premières lignes pour voir où commence l'en-tête
readLines("data/auto2004_original_ligne3.txt", n = 5, encoding = "latin1")
# Les deux premières lignes sont des commentaires/métadonnées : il faut sauter 2 lignes (skip = 2).
# Sur Windows/anciens fichiers français, l'encodage est souvent Latin-1 (ISO-8859-1) plutôt qu'UTF-8 :
# si les accents s'affichent mal (caractères ''), il faut préciser fileEncoding = "latin1".
auto_orig <- read.table("data/auto2004_original_ligne3.txt",
header = TRUE,
sep = "\t",       # Adapter à ";" ou "" selon le séparateur réel du fichier
skip = 2,
fileEncoding = "latin1")
# 3. Importation de auto2004_sans_nom.txt avec les noms de colonnes du fichier original
auto_sans_nom <- read.table("data/auto2004_sans_nom.txt",
header = FALSE,
sep = "\t",   # Même séparateur que le fichier original
col.names = names(auto_orig),
fileEncoding = "latin1")
# 4. Puissance moyenne avec valeurs manquantes codées 99999
# Sans na.strings : les 99999 sont traités comme de vraies puissances (faussant la moyenne)
auto_na_brut <- read.table("data/auto2004_don_manquan_99999.txt",
header = TRUE,
sep = "\t",
fileEncoding = "latin1")
# Avec na.strings = "99999" : R convertit les 99999 en vrais NA
auto_na_propre <- read.table("data/auto2004_don_manquan_99999.txt",
header = TRUE,
sep = "\t",
na.strings = "99999",
fileEncoding = "latin1")
# Calcul des deux moyennes et de l'écart (adapter le nom exact de la colonne puissance si besoin, ex: Puissance)
moy_sans_na <- mean(auto_na_brut$Puissance, na.rm = TRUE)
moy_avec_na <- mean(auto_na_propre$Puissance, na.rm = TRUE)
ecart_moyenne <- moy_sans_na - moy_avec_na
ecart_moyenne
# 5. Importation de la feuille "2024" de pluie_mensuelle.xlsx et station au cumul maximal
library(readxl)
pluie_2024 <- read_excel("data/pluie_mensuelle.xlsx", sheet = "2024")
# Calcul du cumul annuel par station (en supposant que la 1re colonne contient le nom des stations
# et les colonnes 2 à 13 les précipitations des 12 mois)
cumuls <- rowSums(pluie_2024[, -1], na.rm = TRUE)
station_max <- pluie_2024[[1]][which.max(cumuls)]
station_max
max(cumuls)
