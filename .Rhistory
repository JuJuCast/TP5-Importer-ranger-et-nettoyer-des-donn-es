if (!dir.exists("data")) {
dir.create("data")
}
# 2. Importation de auto2004_original_ligne3.txt
# Vérification des premières lignes (sans encoding forcé pour tester l'affichage des accents)
readLines("data/auto2004_original_ligne3.txt", n = 5)
# -> Les lignes 1 à 3 sont des métadonnées ("Fichier auto", "24 observations", "1 variable caractère...").
# -> L'en-tête est sur la ligne 4 : il faut donc sauter 3 lignes (skip = 3).
# -> Sans fileEncoding = "latin1" (sous Windows/UTF-8 récent), le "è" de "caractère" s'affiche mal
#    ou inversement selon ton OS : fileEncoding = "latin1" permet de bien lire les accents Windows.
auto_orig <- read.table("data/auto2004_original_ligne3.txt",
header = TRUE,
sep = "\t",
skip = 3,
fileEncoding = "latin1")
head(auto_orig)
# 3. Importation de auto2004_sans_nom.txt avec les noms de colonnes du fichier original
auto_sans_nom <- read.table("data/auto2004_sans_nom.txt",
header = FALSE,
sep = "\t",
col.names = names(auto_orig),
fileEncoding = "latin1")
head(auto_sans_nom)
# 4. Puissance moyenne avec valeurs manquantes codées 99999
auto_na_brut <- read.table("data/auto2004_don_manquan_99999.txt",
header = TRUE,
sep = "\t",
fileEncoding = "latin1")
auto_na_propre <- read.table("data/auto2004_don_manquan_99999.txt",
header = TRUE,
sep = "\t",
na.strings = "99999",
fileEncoding = "latin1")
moy_sans_na <- mean(auto_na_brut$Puissance, na.rm = TRUE)
moy_avec_na <- mean(auto_na_propre$Puissance, na.rm = TRUE)
ecart_moyenne <- moy_sans_na - moy_avec_na
ecart_moyenne # 16630.13
# 5. Importation de la feuille "2024" de pluie_mensuelle.xlsx
library(readxl)
# On affiche les premières lignes brutes pour voir où commence le vrai en-tête du tableau
read_excel("data/pluie_mensuelle.xlsx", sheet = "2024", col_names = FALSE, n_max = 6)
# Si un titre occupe la 1re ligne (et une ligne vide la 2e), ajuste skip = 1 ou skip = 2 ci-dessous :
pluie_2024 <- read_excel("data/pluie_mensuelle.xlsx", sheet = "2024", skip = 2)
# Calcul du cumul annuel par station (colonnes numériques uniquement)
cols_num <- sapply(pluie_2024, is.numeric)
cumuls <- rowSums(pluie_2024[, cols_num], na.rm = TRUE)
station_max <- pluie_2024[[1]][which.max(cumuls)]
station_max
max(cumuls)
