library(dplyr)
library(tidyr)
# 1. Passer pluie25 au format long : une ligne par station et par mois
# On pivote toutes les colonnes sauf la première (le nom de la station)
pluie25_long <- pluie25 %>%
pivot_longer(
cols = -1,
names_to = "mois",
values_to = "pluie"
)
# 2. Cumul annuel et mois le plus pluvieux de chaque station
# (En supposant que la 1re colonne s'appelle 'station' ; sinon adapter le nom dans group_by)
bilan_pluie25 <- pluie25_long %>%
group_by(across(1)) %>%
summarise(
cumul_annuel = sum(pluie, na.rm = TRUE),
mois_plus_pluvieux = mois[which.max(pluie)],
pluie_max = max(pluie, na.rm = TRUE),
.groups = "drop"
)
print(bilan_pluie25)
# 3. Note moyenne par vin et par étape, puis passage au format large
# (Adapter les noms exacts des colonnes de vins_long si besoin : ex. vin, etape, note)
vins_large <- vins_long %>%
group_by(vin, etape) %>%
summarise(note_moyenne = mean(note, na.rm = TRUE), .groups = "drop") %>%
pivot_wider(
names_from = etape,
values_from = note_moyenne
)
print(vins_large)
# 4. Vin ayant la meilleure note moyenne à l'étape tasting
meilleur_vin_tasting <- vins_large %>%
slice_max(order_by = tasting, n = 1)
print(meilleur_vin_tasting)
library(dplyr)
library(tidyr)
library(readxl)
# Sinon, importation directe depuis les fichiers du dossier data/ :
list.files("data") # Affiche les fichiers disponibles pour vérifier leurs noms exacts
# Importation de pluie25 (feuille "2025" de pluie_mensuelle.xlsx, ajuste skip si besoin)
pluie25 <- read_excel("data/pluie_mensuelle.xlsx", sheet = "2025", skip = 2)
# 1. Passer pluie25 au format long : une ligne par station et par mois
pluie25_long <- pluie25 %>%
pivot_longer(
cols = -1,
names_to = "mois",
values_to = "pluie"
)
# 2. Cumul annuel et mois le plus pluvieux de chaque station
bilan_pluie25 <- pluie25_long %>%
group_by(across(1)) %>%
summarise(
cumul_annuel = sum(pluie, na.rm = TRUE),
mois_plus_pluvieux = mois[which.max(pluie)],
pluie_max = max(pluie, na.rm = TRUE),
.groups = "drop"
)
print(bilan_pluie25)
# 3. Note moyenne par vin et par étape, puis passage au format large
vins_large <- vins_long %>%
group_by(across(c(1, 2))) %>% # Regroupe par les 2 premières colonnes (vin et étape)
summarise(note_moyenne = mean(across(where(is.numeric))[[1]], na.rm = TRUE), .groups = "drop") %>%
pivot_wider(
names_from = 2,
values_from = note_moyenne
)
print(vins_large)
