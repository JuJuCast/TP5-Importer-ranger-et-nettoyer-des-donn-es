library(dplyr)
library(tidyr)
library(readxl)
# --- Questions 1 & 2 : pluie25 ---
pluie25 <- read_excel("data/pluie_mensuelle.xlsx", sheet = "2025", skip = 2)
pluie25_long <- pluie25 %>%
pivot_longer(
cols = -1,
names_to = "mois",
values_to = "pluie"
)
bilan_pluie25 <- pluie25_long %>%
group_by(across(1)) %>%
summarise(
cumul_annuel = sum(pluie, na.rm = TRUE),
mois_plus_pluvieux = mois[which.max(pluie)],
pluie_max = max(pluie, na.rm = TRUE),
.groups = "drop"
)
print(bilan_pluie25)
# --- Questions 3 & 4 : wines.xlsx -> vins_long ---
# Inspection des feuilles et de la structure de wines.xlsx
excel_sheets("data/wines.xlsx")
wines_brut <- read_excel("data/wines.xlsx")
head(wines_brut)
# Passage au format long (vins_long) :
# Si les colonnes sont : Vin, Juge (ou Degustateur), rest, view, shaking, tasting
vins_long <- wines_brut %>%
pivot_longer(
cols = c(rest, view, shaking, tasting),
names_to = "etape",
values_to = "note"
)
# 3. Note moyenne de chaque vin par étape, puis retour au format large
vins_large <- vins_long %>%
group_by(across(1), etape) %>%
summarise(note_moyenne = mean(note, na.rm = TRUE), .groups = "drop") %>%
pivot_wider(
names_from = etape,
values_from = note_moyenne
)
library(dplyr)
library(tidyr)
library(readxl)
# 1. Passer pluie25 au format long : une ligne par station et par mois
pluie25 <- read_excel("data/pluie_mensuelle.xlsx", sheet = "2025", skip = 2)
pluie25_long <- pluie25 %>%
pivot_longer(
cols = -1,
names_to = "mois",
values_to = "pluie"
)
# 2. Cumul annuel et mois le plus pluvieux de chaque station
bilan_pluie25 <- pluie25_long %>%
group_by(across(1)) %>%
summarise(
cumul_annuel = sum(pluie, na.rm = TRUE),
mois_plus_pluvieux = mois[which.max(pluie)],
pluie_max = max(pluie, na.rm = TRUE),
.groups = "drop"
)
print(bilan_pluie25)
# 3. Importation de wines.xlsx -> création de vins_long -> moyennes par étape -> format large
wines <- read_excel("data/wines.xlsx", sheet = "Sheet1")
vins_long <- wines %>%
pivot_longer(
cols = matches("^(rest|view|shaking|tasting)[0-9]+$"),
names_to = "etape",
names_pattern = "^([a-z]+)[0-9]+$",
values_to = "note"
)
vins_large <- vins_long %>%
group_by(Wines, etape) %>%
summarise(note_moyenne = mean(note, na.rm = TRUE), .groups = "drop") %>%
pivot_wider(
names_from = etape,
values_from = note_moyenne
) %>%
select(Wines, rest, view, shaking, tasting) # Réordonne les colonnes dans l'ordre des étapes
print(vins_large, n = 21)
# 4. Vin ayant la meilleure note moyenne à l'étape tasting
meilleur_vin_tasting <- vins_large %>%
slice_max(order_by = tasting, n = 1)
print(meilleur_vin_tasting)
